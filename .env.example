# 数据库配置 (选项 1: 独立字段)
DB_SCHEME=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=networkbackup
DB_PASSWORD=password
DB_NAME=networkbackup

# 数据库配置 (选项 2: 连接字符串 - 优先级更高)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=sqlite:///./dev.db

SECRET_KEY=dev-secret-key-change-me
TIMEZONE_OFFSET=+08:00

# Redis 配置 (用于 Celery 消息代理和结果存储)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Celery 配置 (若设置则覆盖上述 Redis 自动生成的配置)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Redis semaphore failures retry backup tasks by default to protect devices/network.
CELERY_REDIS_SEMAPHORE_FAIL_OPEN=false
DEFAULT_LOCALE=zh-CN
SUPPORTED_LOCALES=zh-CN,en-US
