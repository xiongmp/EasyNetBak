# docker环境配置模板
# 使用方法：复制此文件并重命名为 .env,然后修改其中的值,主要修改DB_USER、DB_PASSWORD、DB_NAME以及SECRET_KEY

# 数据库配置
DB_SCHEME=postgresql
DB_HOST=db    
DB_PORT=5432
DB_USER=networkbackup
DB_PASSWORD=your_secure_password_here
DB_NAME=networkbackup


# Redis / Celery 配置
REDIS_HOST=redis    
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# 应用配置
# SECRET_KEY 用于加密凭据和 Session，必须为随机长字符串，且一旦运行请勿随意更改
SECRET_KEY=your_random_64_character_string_here
APP_NAME=网络设备备份系统
TIMEZONE_OFFSET=+08:00
ENABLE_SCHEDULER=true
